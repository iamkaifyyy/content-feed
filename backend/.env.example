# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/content-feed

# Authentication (JWT Secret - use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# Optional External API Key (if using third-party content providers)
EXTERNAL_API_KEY=your_external_api_key_here
